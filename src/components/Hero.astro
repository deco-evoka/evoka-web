---
import { heroImages, translate, type Locale } from "../lib/catalog-view";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = (key: Parameters<typeof translate>[1]) => translate(locale, key);
---

<section class="hero wrap">
  <div class="hero-copy">
    <p class="eyebrow">{t("heroEyebrow")}</p>
    <h1>{t("heroTitle")}<br /><em>{t("heroTitleAccent")}</em></h1>
    <p class="hero-text">{t("heroText")}</p>
    <div class="hero-actions">
      <a class="button button-dark" href="#catalogo"
        >{t("catalogButton")}</a
      ><a class="hero-secondary-link" href="#categorias"
        >{t("heroSecondaryButton")} <span>→</span></a
      >
    </div>
  </div>
  <div class="hero-visual" aria-label="Galería de imágenes Evoka">
    <div class="hero-shape hero-shape-one"></div><div
      class="hero-shape hero-shape-two"
    >
    </div>
    <div class="hero-slides">
      {
        heroImages.map((image, index) => (
          <div
            class={`hero-slide ${index === 0 ? "is-active" : ""}`}
            data-hero-slide={index}
          >
            <img
              src={image}
              alt={`Evoka · imagen ${index + 1}`}
              loading={index === 0 ? "eager" : "lazy"}
            />
          </div>
        ))
      }
    </div>
    <div class="hero-label">
      <span>EVK / 2026</span><strong
        >{t("heroLabel")}<br /><em>{t("heroLabelAccent")}</em></strong
      >
    </div>
    <div class="hero-controls" aria-label="Controles de la selección">
      <button
        type="button"
        class="hero-control"
        data-hero-prev
        aria-label={t("prev")}>←</button
      >
      <span class="hero-index"
        ><b data-hero-current>01</b>
        <span>/</span>
        {heroImages.length.toString().padStart(2, "0")}</span
      >
      <button
        type="button"
        class="hero-control"
        data-hero-next
        aria-label={t("next")}>→</button
      >
    </div>
  </div>
</section>

<script>
  const heroSlides = [
    ...document.querySelectorAll<HTMLElement>("[data-hero-slide]"),
  ];
  const heroCurrent = document.querySelector<HTMLElement>(
    "[data-hero-current]",
  )!;
  const heroPrev = document.querySelector<HTMLButtonElement>(
    "[data-hero-prev]",
  )!;
  const heroNext = document.querySelector<HTMLButtonElement>(
    "[data-hero-next]",
  )!;
  let heroIndex = 0;
  let heroTimer: number | undefined;
  const showHeroSlide = (nextIndex: number) => {
    heroIndex = (nextIndex + heroSlides.length) % heroSlides.length;
    heroSlides.forEach((slide, index) =>
      slide.classList.toggle("is-active", index === heroIndex),
    );
    heroCurrent.textContent = String(heroIndex + 1).padStart(2, "0");
  };
  const restartHeroTimer = () => {
    window.clearInterval(heroTimer);
    heroTimer = window.setInterval(() => showHeroSlide(heroIndex + 1), 5000);
  };
  heroPrev.addEventListener("click", () => {
    showHeroSlide(heroIndex - 1);
    restartHeroTimer();
  });
  heroNext.addEventListener("click", () => {
    showHeroSlide(heroIndex + 1);
    restartHeroTimer();
  });
  restartHeroTimer();
</script>
